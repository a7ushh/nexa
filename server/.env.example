# ---------------------------------------------------------------------------
# GRAG Production ERP - server environment
# Copy to server/.env (or let `npm run setup` generate it for you).
# ---------------------------------------------------------------------------

# HTTP
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# PostgreSQL (spec: port 6789)
PGHOST=localhost
PGPORT=6789
PGDATABASE=grag_erp
PGUSER=postgres
PGPASSWORD=

# Session / JWT secrets - generate with: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=

# Session behaviour (spec: dies with the browser, or after 10 minutes idle)
IDLE_TIMEOUT_MINUTES=10

# Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an "Authorised redirect URI" on the OAuth client exactly, or Google
# replies with "Error 400: redirect_uri_mismatch".
# Leave blank to use <APP_URL>/api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Google Drive backup target folder id (optional - blank uploads to My Drive root)
GOOGLE_DRIVE_FOLDER_ID=

# Root user seeded by the setup script
ROOT_EMAIL=
ROOT_NAME=Root
ROOT_USERNAME=root
ROOT_PIN=
