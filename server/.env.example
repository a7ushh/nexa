# ---------------------------------------------------------------------------
# GRAG Production ERP - server environment
# Copy to server/.env (or let `npm run setup` generate it for you).
# ---------------------------------------------------------------------------

# HTTP
PORT=5000

# development = Vite dev server in Express middleware, hot reload.
# production  = serve the built client from client/dist. Required for the
#               public deployment: Vite's dev server must never face the tunnel.
NODE_ENV=development

# The one origin the app answers on. The scheme is mandatory - the server
# refuses to boot without it, because a bare "example.com" makes Google reject
# the derived redirect URI with "Error 400: invalid_request" and drops `secure`
# from the session cookie.
#
# This also decides who can reach the app: any request whose Host is not
# APP_URL's host (or the www. spelling) is refused with 403, and the listener
# binds 127.0.0.1 only. Set it to http://localhost:5000 for a local-only
# install; set it to https://your-domain for a tunnelled deployment.
APP_URL=http://localhost:5000

# PostgreSQL (spec: port 6789)
PGHOST=localhost
PGPORT=6789
PGDATABASE=grag_erp
PGUSER=postgres
PGPASSWORD=

# Session / JWT secrets - generate with: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=

# Session behaviour (spec: dies with the browser, or after 10 minutes idle)
IDLE_TIMEOUT_MINUTES=10

# Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an "Authorised redirect URI" on the OAuth client exactly, or Google
# replies with "Error 400: redirect_uri_mismatch".
# Leave blank to use <APP_URL>/api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Google Drive backup target folder id (optional - blank uploads to My Drive root).
# A pasted drive.google.com/drive/folders/<id> link is reduced to the id.
GOOGLE_DRIVE_FOLDER_ID=

# Root user seeded by the setup script
ROOT_EMAIL=
ROOT_NAME=Root
ROOT_USERNAME=root
ROOT_PIN=
